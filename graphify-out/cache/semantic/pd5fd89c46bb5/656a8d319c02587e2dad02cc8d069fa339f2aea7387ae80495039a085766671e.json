{"nodes": [{"id": "design_map_utxowallet_blueprint", "label": "utxoWallet native Android clone \u2014 figma-style mapping & build blueprint", "file_type": "document", "source_file": "DESIGN_MAP.md", "source_location": "L1-L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source of truth is the dapp index.html v1.0.52; every field/behaviour in the dapp must exist in the APK so the clone is exact \u2014 'cut no corners'."}, {"id": "design_map_index_html_source_of_truth", "label": "utxoWallet index.html v1.0.52 (source of truth)", "file_type": "document", "source_file": "DESIGN_MAP.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_design_language_toggle", "label": "Runtime design-language toggle (ORIGINAL / CURRENT)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L10-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two switchable design languages chosen in CFG, persisted, applied app-wide via activity recreate(); all view code reads a central Design token object so colors are never hard-coded."}, {"id": "design_map_design_token_object", "label": "Central Design token object", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L12-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single indirection point so a runtime theme/design switch can repaint the whole app; hard-coded colors would break the toggle."}, {"id": "design_map_original_design_language", "label": "ORIGINAL design language (brutalist/terminal)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L15-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Faithful to the dapp: monospace, hard 1px borders, 0 radius, uppercase tracked micro-labels, tabular-nums; light default + photo-negative dark, accent #ff5a1f constant across both."}, {"id": "design_map_current_design_language", "label": "CURRENT design language (native dark, Material)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L19-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The existing native look \u2014 dark #0A0A0F bg, #15151F cards, accent #F7931A, rounded Material buttons, sans-serif; dark-only, so the light/dark theme toggle applies only within ORIGINAL."}, {"id": "design_map_theme_toggle", "label": "Light/dark theme toggle (ORIGINAL only)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_design_tokens", "label": "Design tokens (colors, type, metrics)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L25-L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0 radius everywhere, hard offset shadows and monospace base 13sp encode the terminal aesthetic as data rather than per-view styling."}, {"id": "design_map_component_catalog", "label": "Component catalog (btn, field, card, utxo-row, modal, toast, pills)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L67-L88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_status_pill", "label": "Status pill (coin + history)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L60-L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_app_shell", "label": "App shell \u2014 nav + tabs", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L91-L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Balances/History/CFG are lazy-rendered on tab select to avoid paying for screens the user may never open."}, {"id": "design_map_live_block_indicator", "label": "Live block indicator (pulsing accent dot + #chainBlock)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L93-L95", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_wallet_screen", "label": "Wallet screen (address cards + coin rows)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L103-L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-tokenid lock: tapping a coin of a different token clears the selection, because a txn's outputs cannot mix token ids."}, {"id": "design_map_selection_bar", "label": "Selection bar (Clear / Tools \u25be / Send \u2192)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L104-L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tools/Send are enabled only with a selection + WRITE permission + not locked + no pending job, so unsignable actions are unreachable rather than failing late."}, {"id": "design_map_balances_screen", "label": "Balances screen (per-token bal-card)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L114-L119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sendable/Locked split is shown only when locked>0; Consolidate is surfaced per-token once coin count \u2265 3."}, {"id": "design_map_history_screen", "label": "History screen (history-row + details)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L121-L130", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_status_buckets", "label": "History status buckets (posting/finalizing \u2192 Sending, etc.)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L127-L129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many raw internal states collapse into five user-facing buckets so the terminal actions (Resume / Re-post / Dismiss) map one-to-one onto what the user can actually do."}, {"id": "design_map_explorer_link", "label": "Explorer deep link (explorer.minima.global/transactions/<txid>)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L125-L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_cfg_screen", "label": "CFG (Settings) screen", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L132-L140", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_defaultchangemode", "label": "defaultChangeMode (rotate | first input)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L134-L135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rotate cycles the 64 default addresses (privacy); 'first input' returns change to the source coin's address (traceability/simplicity). Default is rotate."}, {"id": "design_map_write_permission_probe", "label": "WRITE permission probe (txncreate \u2192 txndelete)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L136-L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write capability is proven by actually creating and deleting a throwaway txn rather than trusting a flag; on the IPC transport the analog is 'enabled in Minima Core'."}, {"id": "design_map_node_lock_state", "label": "Node lock state check", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_send_flow", "label": "Send flow (full construction) \u2014 Send + Confirm modals", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L146-L170", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The core flow: inputs \u2192 recipient \u2192 amount \u2192 change \u2192 burn \u2192 preview \u2192 confirm, with an irreversibility warning because a posted txn cannot be undone."}, {"id": "design_map_validateaddress", "label": "validateAddress", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L150-L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepts 0x + exactly 64 hex, or Mx + 40\u2013118 alphanumerics; format check runs before any node round-trip."}, {"id": "design_map_validateamount", "label": "validateAmount(amt, maxSpendable)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L152-L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AMOUNT_RE ^(0|[1-9][0-9]*)(\\.[0-9]{1,44})?$ bounds decimals at 44 places; must be >0 and \u2264 max sendable."}, {"id": "design_map_resolvedefaultchangeaddr", "label": "resolveDefaultChangeAddr", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L153-L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rotate \u2192 getaddress; first-input \u2192 source coin address if mine else getaddress. Change address is required unless amount+burn == total ('No change \u2014 full amount sent')."}, {"id": "design_map_buildtransaction", "label": "buildTransaction", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L164-L170", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact command order: record history (posting) \u2192 txncreate \u2192 txninput per coin \u2192 txnoutput per recipient \u2192 txnoutput change \u2192 txnsign. History is recorded BEFORE posting so a crash mid-post still leaves a resumable row."}, {"id": "design_map_signandpost", "label": "signAndPost", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L166-L170", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "txnsign publickey:auto txnpostauto:true txndelete:true, burn only when Minima and >0; pending/READ-mode goes awaiting_approval and resumes on NEWBLOCK (throttle 2 blocks, expiry 20 blocks) as a single-shot after txncheck."}, {"id": "design_map_post_size_guard", "label": "64KB post-size guard", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L167-L168", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-flight estimate stops an oversized TxPoW before it is built; overhead model 4096 base / 6144 per input / 900 per output."}, {"id": "design_map_estimatetxpowbytes", "label": "estimateTxPowBytes", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L167-L168", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_oversizedposterror", "label": "oversizedPostError", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L167", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_split_flow", "label": "Split flow (2\u201315 coins)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L172-L175", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each share is total/n rounded DOWN to the token's decimals with the remainder assigned to the last output, so the outputs always sum exactly to the inputs."}, {"id": "design_map_distribute_flow", "label": "Distribute flow (auto-chained batches)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L177-L186", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batch 1's change coin funds the next batch; the job auto-chains on each NEWBLOCK by locating the change coin (by coinid, fallback addr+amount), posting no burn on later batches, expiry ~25 blocks."}, {"id": "design_map_max_addr_outputs_per_batch", "label": "MAX_ADDR_OUTPUTS_PER_BATCH = 14", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L180", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caps outputs per transaction so a distribute never trips the 64KB post-size guard; batchCount = ceil(N/14)."}, {"id": "design_map_distribute_affordability_fix", "label": "Distribute affordability rule fix (strict >, allow change 0)", "file_type": "rationale", "source_file": "DESIGN_MAP.md", "source_location": "L181-L184", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Known bug: the current code rejects needed == total. Correct rule is needed = N\u00d7perAddr + burn, reject ONLY if needed > total; a zero-change spend-everything distribute is legal and must be allowed (and no change address fetched)."}, {"id": "design_map_consolidate_flow", "label": "Consolidate flow", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L188-L192", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No selection \u2192 auto `consolidate tokenid:0x00`; 2+ selected \u2192 merge exactly those into one output at a fresh address. The full dialog (maxcoins 3\u201320, coinage, burn, dry-run 'spent/created/net' preview, post only if it reduces) is offered as the Balances per-token path."}, {"id": "design_map_untrack_track_receive", "label": "Untrack / Track / Receive flows", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L194-L196", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_state_persistence", "label": "State & persistence (SharedPreferences + SQLite history)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L201-L203", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app keeps its own rich local history (internalid, txnid, status, inputs/outputs JSON, changeaddr, burn, postblock) rather than relying on the node's `history` command."}, {"id": "design_map_newblock_event", "label": "NEWBLOCK event handler", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L204-L206", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One tick drives everything time-based: block number, coin reload, pending resume, confirmation watching and distribute chaining."}, {"id": "design_map_newbalance_event", "label": "NEWBALANCE event handler (debounced)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L206", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads are debounced so a burst of balance notifications does not flood the IPC transport."}, {"id": "design_map_selection_model", "label": "Selection model (selected, selectedTokenid, sendableCoinIds)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L207-L208", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_command_reference", "label": "Command reference over MinimaAPI.Command", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L209-L212", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_build_order", "label": "Build order (tokens \u2192 shell \u2192 wallet \u2192 send \u2192 \u2026 \u2192 release)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "L214-L217", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design tokens and the toggle come first because every later screen reads them; build \u2192 code-review \u2192 fix \u2192 review \u2192 release closes the loop."}], "edges": [{"source": "claude_reuse_before_reinvent", "target": "design_map_index_html_source_of_truth", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "DESIGN_MAP.md", "source_location": "L3", "weight": 1.0}, {"source": "design_map_utxowallet_blueprint", "target": "design_map_index_html_source_of_truth", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L3", "weight": 1.0}, {"source": "design_map_utxowallet_blueprint", "target": "design_map_design_language_toggle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L10-L21", "weight": 1.0}, {"source": "design_map_design_language_toggle", "target": "design_map_original_design_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L15-L18", "weight": 1.0}, {"source": "design_map_design_language_toggle", "target": "design_map_current_design_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L19-L20", "weight": 1.0}, {"source": "design_map_design_language_toggle", "target": "design_map_design_token_object", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L12-L13", "weight": 1.0}, {"source": "design_map_design_token_object", "target": "design_map_design_tokens", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L25-L47", "weight": 1.0}, {"source": "design_map_theme_toggle", "target": "design_map_original_design_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L21", "weight": 1.0}, {"source": "design_map_cfg_screen", "target": "design_map_design_language_toggle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L139", "weight": 1.0}, {"source": "design_map_component_catalog", "target": "design_map_design_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L67-L88", "weight": 1.0}, {"source": "design_map_component_catalog", "target": "design_map_status_pill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L80", "weight": 1.0}, {"source": "design_map_app_shell", "target": "design_map_live_block_indicator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L93-L95", "weight": 1.0}, {"source": "design_map_app_shell", "target": "design_map_theme_toggle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L93-L95", "weight": 1.0}, {"source": "design_map_app_shell", "target": "design_map_wallet_screen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L96-L97", "weight": 1.0}, {"source": "design_map_app_shell", "target": "design_map_balances_screen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "L96-L97", "weight": 1.0}, {"source": "design_map_app_shell", "target": "design_map_history_screen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location"